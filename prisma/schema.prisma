generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Garment {
  id        String   @id @default(cuid())
  category  Category
  colors    Color[]
  texture   Texture
  pattern   Pattern
  season    String
  size      String
  fit       Fit
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Color {
  id        String  @id @default(cuid())
  hex       String
  garmentId String
  garment   Garment @relation(fields: [garmentId], references: [id], onDelete: Cascade)
}

enum Category {
  SWEATER
  SHIRT
  PANTS
  SOCKS
  SHOES
}

enum Texture {
  KNIT
  DENIM
  LINEN
  COTTON
  POLYESTER
  LEATHER
  SYNTHETIC
}

enum Pattern {
  PLAIN
  STRIPES
  CHECKS
  FLORAL
  PRINTED
  GEOMETRIC
}

enum Fit {
  OVERSIZED
  STRAIGHT
  CROPPED
  SLIM
  BAGGY
  REGULAR
}
