generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Garment {
  id        String           @id @default(cuid())
  category  Category
  colors    Color[]
  seasons   GarmentSeason[]
  texture   Texture?
  pattern   Pattern?
  size      String?
  subtype   String?
  length    String?
  fit       String?
  notes     String?
  image     String?
  outfits   OutfitGarment[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}

model Outfit {
  id         String          @id @default(cuid())
  name       String?
  paletteId  Int
  favorite   Boolean         @default(false)
  garments   OutfitGarment[]
  wornEvents WornEvent[]
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
}

// One row per calendar day: `date` is a day (time truncated to midnight),
// not a click timestamp — the unique constraint is what enforces
// "at most one outfit per day" for the weekly planner.
model WornEvent {
  id       String   @id @default(cuid())
  outfitId String
  date     DateTime @default(now())
  outfit   Outfit   @relation(fields: [outfitId], references: [id], onDelete: Cascade)

  @@unique([date])
  @@index([outfitId])
}

model OutfitGarment {
  id        String  @id @default(cuid())
  outfitId  String
  garmentId String
  // "primary": part of the palette-matched core.
  // "extra":   added manually (shoes / socks / accessories),
  //            outside the colour engine.
  role      String  @default("primary")
  outfit    Outfit  @relation(fields: [outfitId], references: [id], onDelete: Cascade)
  garment   Garment @relation(fields: [garmentId], references: [id], onDelete: Cascade)

  @@unique([outfitId, garmentId])
  @@index([outfitId])
  @@index([garmentId])
}

model Color {
  id        String  @id @default(cuid())
  hex       String
  garmentId String
  garment   Garment @relation(fields: [garmentId], references: [id], onDelete: Cascade)

  @@unique([garmentId, hex])
  @@index([garmentId])
}

model GarmentSeason {
  id        String   @id @default(cuid())
  garmentId String
  season    Season
  garment   Garment  @relation(fields: [garmentId], references: [id], onDelete: Cascade)

  @@unique([garmentId, season])
  @@index([garmentId])
}

enum Category {
  SWEATER
  SHIRT
  PANTS
  SOCKS
  SHOES
  ACCESSORI
}

enum Texture {
  KNIT
  DENIM
  LINEN
  COTTON
  POLYESTER
  LEATHER
  SYNTHETIC
}

enum Pattern {
  PLAIN
  STRIPES
  CHECKS
  FLORAL
  PRINTED
  GEOMETRIC
}

enum Season {
  SPRING
  SUMMER
  AUTUMN
  WINTER
  ALL_YEAR
}
