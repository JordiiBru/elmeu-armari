generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Garment {
  id        String           @id @default(cuid())
  /// Whose wardrobe this piece is in. Every query for garments, outfits and
  /// days is scoped by it: there is one wardrobe per account.
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  Category
  colors    Color[]
  seasons   GarmentSeason[]
  texture   Texture?
  pattern   Pattern?
  size      String?
  subtype   String?
  length    String?
  fit       String?
  notes     String?
  image     String?
  /// null = clean. Set to the moment the garment was marked dirty.
  dirtySince DateTime?
  outfits   OutfitGarment[]
  wornWith  WornEventGarment[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([userId])
}

model Outfit {
  id         String          @id @default(cuid())
  userId     String
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String?
  paletteId  Int
  favorite   Boolean         @default(false)
  garments   OutfitGarment[]
  wornEvents WornEvent[]
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([userId])
}

// One row per calendar day and account: `date` is a day (time truncated to
// midnight), not a click timestamp — the unique constraint is what enforces
// "at most one outfit per day" for the weekly planner, for each wardrobe.
model WornEvent {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  outfitId String
  date     DateTime @default(now())
  /// null = not settled yet. Wearing an outfit only assigns the day;
  /// its washable pieces are dirtied once this day has fully passed
  /// (see settlePastWornEvents), so reconsidering same-day never soils
  /// clothes you didn't actually wear.
  settledAt DateTime?
  /// Filename of the photo you took of yourself that day, or null. Same
  /// shape as Garment.image: the file lives under UPLOAD_DIR, only its
  /// name is stored. It belongs to the day, not to the outfit — the same
  /// outfit worn twice is two different mornings.
  image     String?
  /// Only reason this exists: cache-busting the photo, whose filename is
  /// derived from the row id and therefore never changes when replaced.
  updatedAt DateTime @default(now()) @updatedAt
  outfit   Outfit   @relation(fields: [outfitId], references: [id], onDelete: Cascade)
  /// Accessories worn that day — what varies regardless of which
  /// outfit was picked. Shoes are part of the outfit itself now.
  garments WornEventGarment[]

  @@unique([userId, date])
  @@index([outfitId])
}

model WornEventGarment {
  id          String    @id @default(cuid())
  wornEventId String
  garmentId   String
  wornEvent   WornEvent @relation(fields: [wornEventId], references: [id], onDelete: Cascade)
  garment     Garment   @relation(fields: [garmentId], references: [id], onDelete: Cascade)

  @@unique([wornEventId, garmentId])
  @@index([wornEventId])
  @@index([garmentId])
}

// A garment can be a normal wardrobe piece (matched against a palette,
// see the colour engine) or a shoe (matched the same way, but never
// required — a look can be complete without one). Accessories
// never appear here: they live on the day (WornEventGarment) instead,
// since nobody picks a look around them.
model OutfitGarment {
  id        String  @id @default(cuid())
  outfitId  String
  garmentId String
  outfit    Outfit  @relation(fields: [outfitId], references: [id], onDelete: Cascade)
  garment   Garment @relation(fields: [garmentId], references: [id], onDelete: Cascade)

  @@unique([outfitId, garmentId])
  @@index([outfitId])
  @@index([garmentId])
}

model Color {
  id        String  @id @default(cuid())
  hex       String
  garmentId String
  garment   Garment @relation(fields: [garmentId], references: [id], onDelete: Cascade)

  @@unique([garmentId, hex])
  @@index([garmentId])
}

model GarmentSeason {
  id        String   @id @default(cuid())
  garmentId String
  season    Season
  garment   Garment  @relation(fields: [garmentId], references: [id], onDelete: Cascade)

  @@unique([garmentId, season])
  @@index([garmentId])
}

enum Category {
  SWEATER
  SHIRT
  PANTS
  SHOES
  ACCESSORI
}

enum Texture {
  KNIT
  DENIM
  LINEN
  COTTON
  POLYESTER
  LEATHER
  SYNTHETIC
}

enum Pattern {
  PLAIN
  STRIPES
  CHECKS
  FLORAL
  PRINTED
  GEOMETRIC
}

enum Season {
  SPRING
  SUMMER
  AUTUMN
  WINTER
  ALL_YEAR
}

model User {
  id           String    @id @default(cuid())
  /// Stored lower-cased: SQLite's unique index is case sensitive, and
  /// "Jordi" and "jordi" must not be two accounts.
  username     String    @unique
  passwordHash String
  mustChangePw Boolean   @default(true)
  /// Argon2id hash of the recovery code, shown once when the owner chooses a
  /// password. null = none (a temporary password from `create-user` has no
  /// code: there is nothing to recover yet). Lets someone who forgot the
  /// password set a new one without the operator.
  recoveryHash String?
  createdAt    DateTime  @default(now())
  lastLoginAt  DateTime?
  garments     Garment[]
  outfits      Outfit[]
  wornEvents   WornEvent[]
}

/// One row per login attempt, successful or not. It is what the lockout
/// reads: no Redis, no in-memory counter that a restart forgets. Never
/// stores the password or its hash — username, IP and outcome only.
model LoginAttempt {
  id        String   @id @default(cuid())
  username  String
  ip        String
  success   Boolean
  createdAt DateTime @default(now())

  @@index([username, createdAt])
  @@index([ip, createdAt])
}
