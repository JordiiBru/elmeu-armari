generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Garment {
  id        String           @id @default(cuid())
  category  Category
  colors    Color[]
  seasons   GarmentSeason[]
  texture   Texture
  pattern   Pattern
  size      String
  subtype   String?
  fit       String
  notes     String?
  outfits   OutfitGarment[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}

model Outfit {
  id        String          @id @default(cuid())
  name      String?
  paletteId Int
  garments  OutfitGarment[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

model OutfitGarment {
  id        String  @id @default(cuid())
  outfitId  String
  garmentId String
  outfit    Outfit  @relation(fields: [outfitId], references: [id], onDelete: Cascade)
  garment   Garment @relation(fields: [garmentId], references: [id], onDelete: Cascade)

  @@unique([outfitId, garmentId])
  @@index([outfitId])
  @@index([garmentId])
}

model Color {
  id        String  @id @default(cuid())
  hex       String
  garmentId String
  garment   Garment @relation(fields: [garmentId], references: [id], onDelete: Cascade)

  @@index([garmentId])
}

model GarmentSeason {
  id        String   @id @default(cuid())
  garmentId String
  season    Season
  garment   Garment  @relation(fields: [garmentId], references: [id], onDelete: Cascade)

  @@unique([garmentId, season])
  @@index([garmentId])
}

enum Category {
  SWEATER
  SHIRT
  PANTS
  SOCKS
  SHOES
}

enum Texture {
  KNIT
  DENIM
  LINEN
  COTTON
  POLYESTER
  LEATHER
  SYNTHETIC
}

enum Pattern {
  PLAIN
  STRIPES
  CHECKS
  FLORAL
  PRINTED
  GEOMETRIC
}

enum Season {
  SPRING
  SUMMER
  AUTUMN
  WINTER
  ALL_YEAR
}
