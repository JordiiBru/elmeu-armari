generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Garment {
  id        String           @id @default(cuid())
  category  Category
  colors    Color[]
  seasons   GarmentSeason[]
  texture   Texture?
  pattern   Pattern?
  size      String?
  subtype   String?
  length    String?
  fit       String?
  notes     String?
  image     String?
  /// null = clean. Set to the moment the garment was marked dirty.
  dirtySince DateTime?
  outfits   OutfitGarment[]
  wornWith  WornEventGarment[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}

model Outfit {
  id         String          @id @default(cuid())
  name       String?
  paletteId  Int
  favorite   Boolean         @default(false)
  garments   OutfitGarment[]
  wornEvents WornEvent[]
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
}

// One row per calendar day: `date` is a day (time truncated to midnight),
// not a click timestamp — the unique constraint is what enforces
// "at most one outfit per day" for the weekly planner.
model WornEvent {
  id       String   @id @default(cuid())
  outfitId String
  date     DateTime @default(now())
  /// null = not settled yet. Wearing an outfit only assigns the day;
  /// its washable pieces are dirtied once this day has fully passed
  /// (see settlePastWornEvents), so reconsidering same-day never soils
  /// clothes you didn't actually wear.
  settledAt DateTime?
  outfit   Outfit   @relation(fields: [outfitId], references: [id], onDelete: Cascade)
  /// Shoes / socks / accessories worn that day. The outfit itself is
  /// clothes only — what you put on your feet is a property of the day,
  /// not of the look.
  garments WornEventGarment[]

  @@unique([date])
  @@index([outfitId])
}

model WornEventGarment {
  id          String    @id @default(cuid())
  wornEventId String
  garmentId   String
  wornEvent   WornEvent @relation(fields: [wornEventId], references: [id], onDelete: Cascade)
  garment     Garment   @relation(fields: [garmentId], references: [id], onDelete: Cascade)

  @@unique([wornEventId, garmentId])
  @@index([wornEventId])
  @@index([garmentId])
}

// Every row is part of the palette-matched core: shoes, socks and
// accessories live on the day (WornEventGarment), never on the outfit.
model OutfitGarment {
  id        String  @id @default(cuid())
  outfitId  String
  garmentId String
  outfit    Outfit  @relation(fields: [outfitId], references: [id], onDelete: Cascade)
  garment   Garment @relation(fields: [garmentId], references: [id], onDelete: Cascade)

  @@unique([outfitId, garmentId])
  @@index([outfitId])
  @@index([garmentId])
}

model Color {
  id        String  @id @default(cuid())
  hex       String
  garmentId String
  garment   Garment @relation(fields: [garmentId], references: [id], onDelete: Cascade)

  @@unique([garmentId, hex])
  @@index([garmentId])
}

model GarmentSeason {
  id        String   @id @default(cuid())
  garmentId String
  season    Season
  garment   Garment  @relation(fields: [garmentId], references: [id], onDelete: Cascade)

  @@unique([garmentId, season])
  @@index([garmentId])
}

enum Category {
  SWEATER
  SHIRT
  PANTS
  SOCKS
  SHOES
  ACCESSORI
}

enum Texture {
  KNIT
  DENIM
  LINEN
  COTTON
  POLYESTER
  LEATHER
  SYNTHETIC
}

enum Pattern {
  PLAIN
  STRIPES
  CHECKS
  FLORAL
  PRINTED
  GEOMETRIC
}

enum Season {
  SPRING
  SUMMER
  AUTUMN
  WINTER
  ALL_YEAR
}

model User {
  id           String    @id @default(cuid())
  /// Stored lower-cased: SQLite's unique index is case sensitive, and
  /// "Jordi" and "jordi" must not be two accounts.
  username     String    @unique
  passwordHash String
  mustChangePw Boolean   @default(true)
  createdAt    DateTime  @default(now())
  lastLoginAt  DateTime?
}

/// One row per login attempt, successful or not. It is what the lockout
/// reads: no Redis, no in-memory counter that a restart forgets. Never
/// stores the password or its hash — username, IP and outcome only.
model LoginAttempt {
  id        String   @id @default(cuid())
  username  String
  ip        String
  success   Boolean
  createdAt DateTime @default(now())

  @@index([username, createdAt])
  @@index([ip, createdAt])
}
